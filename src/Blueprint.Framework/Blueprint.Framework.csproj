<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The automation framework: page objects, components, API clients, test data, database access, configuration
    and utilities. It does not reference a test runner, so the same code can back NUnit, MSTest or xUnit tests.
  -->

  <ItemGroup>
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied next to every assembly that references this project, including the test project. -->
    <None Update="TestData\Files\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
